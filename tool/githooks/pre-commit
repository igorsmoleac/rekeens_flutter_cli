#!/bin/sh
# Pre-commit hook: formatting + static analysis before every commit.
#
# Install (one time, from the repository root):
#   chmod +x tool/githooks/pre-commit
#   git config core.hooksPath tool/githooks
#
# Skippable for a single commit with: git commit --no-verify

# Staged .dart files (added / copied / modified / renamed).
STAGED=$(git diff --cached --name-only --diff-filter=ACMR | grep '\.dart$')

# Nothing to check — allow the commit.
[ -z "$STAGED" ] && exit 0

# Formatting scope matches CI (lib, test, bin): templates/ contain
# {{placeholders}} that are not valid Dart and cannot be formatted.
set --
while IFS= read -r file; do
  case "$file" in
    lib/*|test/*|bin/*) set -- "$@" "$file" ;;
  esac
done <<EOF
$STAGED
EOF

[ $# -eq 0 ] && exit 0

echo "Checking formatting of $# staged file(s)..."
if ! dart format --output=none --set-exit-if-changed "$@"; then
  echo "❌ Formatting failed. Please run 'dart format lib test bin' and stage the changes." >&2
  exit 1
fi

echo "Running static analysis..."
if ! dart analyze --fatal-infos lib test bin; then
  echo "❌ Static analysis failed." >&2
  exit 1
fi

echo "✅ Pre-commit checks passed!"
exit 0
